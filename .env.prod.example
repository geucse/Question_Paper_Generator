# Copy to .env.prod and fill in real values before running:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
#
# Never commit the filled-in .env.prod to version control.

DB_USER=examportal
DB_PASSWORD=replace-with-a-long-random-password
DB_NAME=examportal

# Optional hardening (see backend/deploy/create-app-role.sql): a separate
# least-privilege role for the running app, distinct from DB_USER above
# (which owns the schema and is what `migrate` runs as). Leave both blank
# to skip this — the app then runs as DB_USER for everything, same as
# before this feature existed.
APP_DATABASE_URL=
DB_APP_PASSWORD=replace-with-a-different-long-random-password

# Generate with: openssl rand -base64 48
# The backend refuses to start with this placeholder (or any value containing "replace-with").
JWT_SECRET=replace-with-a-long-random-string

# Optional — enables the AI reviewer's spelling/grammar/clarity checks.
# Without it, deterministic heuristic checks still run (duplicates, topic
# balance, basic formatting) — the feature degrades, it doesn't break.
ANTHROPIC_API_KEY=

# Port the frontend (nginx) is exposed on. Put a real reverse proxy /
# TLS terminator (e.g. Caddy, or your cloud provider's load balancer) in
# front of this in any real deployment — this compose file does not
# terminate TLS itself.
FRONTEND_PORT=80

# Shown in the header of every exported paper PDF.
INSTITUTION_NAME=
# Optional: approved logo for paper PDFs (PNG/JPEG path inside the backend container) and institution-wide
# instruction lines ("|"-separated). See backend/assets/brand/README.md.
INSTITUTION_LOGO_PATH=
PAPER_GENERAL_INSTRUCTIONS=
# Frontend build: institution name and approved logo URL for the portal header and sign-in screen
# (see frontend/BRANDING.md). Leave the logo empty until the official file is supplied.
VITE_INSTITUTION_NAME=Graphic Era
VITE_BRAND_LOGO_URL=

# ---------------------------------------------------------------------------
# Required security settings. The backend refuses to start in production when
# any of these is missing or invalid (it names the variable, never the value).
# ---------------------------------------------------------------------------

# The exact origin(s) users open the portal at, comma-separated, no paths:
CORS_ALLOWED_ORIGINS=https://exam-portal.example.edu

# Proxy hops in front of the backend: 1 = the bundled frontend nginx only;
# 2 when a TLS proxy / load balancer sits in front of it. Never "true".
TRUST_PROXY=1

# Login codes, password-reset codes and account invitations are emailed (SMTP).
# SMTP_USER/SMTP_PASS together, or both empty for an unauthenticated relay.
# SMTP_SECURE=true for implicit TLS (port 465); otherwise STARTTLS is required.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Encrypts authenticator (TOTP) secrets at rest. Generate with: openssl rand -hex 32
# Keep it with your other secrets. The database stores a check of it: a different key makes the
# backend refuse to start (so a typo never silently breaks every COE approval). To rotate on
# purpose, set TOTP_KEY_ROTATE=yes for ONE start (audited; every user must set up their
# authenticator again), then remove it.
TOTP_ENCRYPTION_KEY=
# TOTP_KEY_ROTATE=yes

# Automatic IP blocks expire after this many minutes (manual blocks stay until removed).
AUTO_BLOCK_MINUTES=60

# Shown in invitation emails ("open <PORTAL_URL> and choose Set up a new account").
PORTAL_URL=https://exam-portal.example.edu
# How long an invitation (account setup code) stays valid.
ACCOUNT_INVITE_TTL_HOURS=72

# How often uploads the virus scanner could not check are rescanned (0 disables).
ATTACHMENT_RESCAN_INTERVAL_MS=600000
