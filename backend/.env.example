# Copy this file to .env and change the secret before any real deployment.
# REQUIRED: JWT_SECRET must be at least 32 characters long
# Generate with: openssl rand -base64 32
JWT_SECRET=replace-with-a-strong-secret-at-least-32-characters-long
PORT=4000

# PostgreSQL connection string. See docker-compose.yml for a local dev DB,
# or run against any Postgres 14+ instance with the pgvector extension
# available (CREATE EXTENSION vector; migration 001 enables it). This is
# also the connection `npm run migrate` uses — it needs schema-owner (DDL)
# privileges.
DATABASE_URL=postgres://examportal:devpassword@localhost:5432/examportal

# Optional hardening: point the RUNNING APP at a separate, least-privilege
# database role that can only read/write rows, never run DDL — see
# backend/deploy/create-app-role.sql. Leave unset to use DATABASE_URL for
# everything (fine for local dev; the owner role can do more than the app
# strictly needs, but nothing breaks).
APP_DATABASE_URL=

# Redis backs shared rate-limit state across backend replicas. In production, while it is
# unreachable (at startup or later) the backend is not ready and refuses rate-limited requests
# with 503; it reconnects by itself.
# Locally, set RATE_LIMIT_STORE=memory to skip Redis entirely (per-process limits).
REDIS_URL=redis://localhost:6379
# RATE_LIMIT_STORE=memory

# Optional — enables the AI reviewer's spelling/grammar/clarity checks.
# Without it, the AI reviewer still runs using deterministic heuristic checks
# (duplicate detection, topic balance, basic formatting) — language-quality
# checks are simply skipped rather than the feature breaking.
ANTHROPIC_API_KEY=

# Shown in the header of every exported paper PDF. Defaults to a visible
# placeholder if unset, deliberately — better an obvious "not configured"
# than a generic/wrong institution name on a real exam paper.
INSTITUTION_NAME=

# Optional: the institution-approved logo printed at the top of every paper (PNG or JPEG only; SVG cannot be
# embedded). Default: backend/assets/brand/institution-logo.png when that file exists; otherwise no logo is printed.
INSTITUTION_LOGO_PATH=
# Optional: institution-wide lines appended to the "Note:" instructions of every paper, separated by "|".
# Example: Use of calculators is not permitted.|Write your roll number on every answer sheet.
PAPER_GENERAL_INSTRUCTIONS=

# Comma-separated list of allowed frontend origins, e.g.
# https://portal.example.edu,https://staging-portal.example.edu
# Unset = allow every origin (development only); production refuses to start without it.
CORS_ALLOWED_ORIGINS=

# Number of proxy hops in front of the backend (req.ip for rate limits, blocking, lockdown).
# 1 by default; 2 behind ingress-nginx + the frontend nginx. Never "true".
# TRUST_PROXY=1

# ---- How login codes, password-reset codes and account invitations reach people ----
# OTP_DELIVERY_PROVIDER=smtp|console
#   smtp     real email (required in production; the server refuses to start otherwise).
#   console  development only, and only together with DEV_OTP_CONSOLE:
#              DEV_OTP_CONSOLE=masked  log line shows code=12**** (delivery happened, code hidden)
#              DEV_OTP_CONSOLE=reveal  log line shows the full code, so you can sign in locally
#            Production ignores and refuses these flags. Codes never appear in API responses.
# With neither configured, sign-in/reset/invitations answer 503 instead of pretending to send.
# For local development without a mail server, the simplest setting is:
#   DEV_OTP_CONSOLE=reveal        (OTP_DELIVERY_PROVIDER then defaults to console)
OTP_DELIVERY_PROVIDER=
DEV_OTP_CONSOLE=
# SMTP (required in production): host, port and from; user/pass together or both empty
# (unauthenticated relay). SMTP_SECURE=true for implicit TLS (465); otherwise STARTTLS is
# required unless SMTP_REQUIRE_TLS=false.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@exam-portal.local

# ---- Accounts ----
# New accounts receive a one-time setup code by email (no temporary passwords).
# PORTAL_URL appears in the invitation email; codes stay valid ACCOUNT_INVITE_TTL_HOURS.
PORTAL_URL=http://localhost:5173
ACCOUNT_INVITE_TTL_HOURS=72
# Development only (ignored and refused in production): also return the setup code in the
# account-creation response, for testing invitations without a mail server.
DEV_EXPOSE_ACCOUNT_SETUP_TOKEN=false

# ---- Authenticator (TOTP) secrets are encrypted at rest ----
# 32 bytes, hex or base64: openssl rand -hex 32. Required in production. Locally, when unset,
# a development key is derived from JWT_SECRET (with a warning). The first start records a key
# check in the database; a different key later (or, locally, a changed JWT_SECRET) is detected:
# production refuses to start, development warns, and authenticator step-up is refused (503)
# until the old key is restored. To rotate on purpose, start ONCE with TOTP_KEY_ROTATE=yes
# (audited; every user sets up their authenticator again), then remove it.
TOTP_ENCRYPTION_KEY=
# TOTP_KEY_ROTATE=yes

# ---- Virus scanning (ClamAV, native clamd protocol) ----
# Production requires CLAMD_HOST (+ CLAMD_PORT) or CLAMD_SOCKET. Locally, without a clamd,
# uploads are stored in uploads/quarantine/ and cannot be used until they are rescanned clean
# (fail-closed). To scan locally:
#   docker run -d --name exam-portal-clamav -p 3310:3310 clamav/clamav:1.3   then CLAMD_HOST=localhost
CLAMD_HOST=
CLAMD_PORT=3310
# CLAMD_SOCKET=/run/clamav/clamd.ctl
# CLAMD_SCAN_TIMEOUT_MS=15000
# How often quarantined uploads are rescanned in the background (0 disables).
# ATTACHMENT_RESCAN_INTERVAL_MS=600000

# /api/health/ready caches dependency checks this long (milliseconds). In production anonymous
# callers get only {"status"}; the details are on the admin's System tab.
# READINESS_CACHE_MS=2000

# Automatic IP blocks (repeated failed logins, bad codes, scans) expire after this many minutes.
# AUTO_BLOCK_MINUTES=60

REVIEWER_CANNOT_TEACH_OFFERING=false   # spec 12 optional rule
